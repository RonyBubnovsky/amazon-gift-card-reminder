{
  "name": "amazon-gift-card-reminder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Amazon stock checker (every 30 minutes) that emails on status changes, sends a daily summary, and alerts on repeated failures.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "check:local": "node --env-file=.env --import tsx scripts/run-local.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.10.3",
    "nodemailer": "^10.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
