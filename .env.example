# Gmail account that sends the emails. Use an App Password, never the real password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Recipient. Defaults to GMAIL_USER when empty.
NOTIFY_TO=

# Comma-separated Amazon product URLs to watch.
PRODUCT_URLS=https://www.amazon.in/dp/B0C1H473H8

# Shared secret cron-job.org sends as "Authorization: Bearer <CRON_SECRET>".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Upstash Redis REST credentials. The Vercel Upstash integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IANA timezone for the daily summary and email timestamps.
TIMEZONE=Asia/Jerusalem
# Hour (0-23, in TIMEZONE) from which the daily summary is sent.
SUMMARY_HOUR=12
